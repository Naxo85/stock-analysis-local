# Copia este archivo como .env.local y completa solo los valores que uses.
# .env.local esta ignorado por Git y no debe subirse.

# Necesaria para consultar el calendario de resultados de Finnhub.
FINN_KEY=
# Alternativa equivalente:
# FINNHUB_API_KEY=

# Opcional: agregacion secundaria de noticias mediante Gemini.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Opcional: proveedor para la agregacion de noticias (codex o gemini).
# NEWS_AGGREGATOR_PROVIDER=codex
